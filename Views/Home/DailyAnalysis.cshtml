@model HubClub.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "التحليل المالي ليوم العمل";
}

<h4 class="topbar-title mb-3 fs-5">1. الإيرادات حسب مصدر الدخل</h4>
<div class="analysis-summary-grid mb-4">
    <div class="summary-box">
        <div class="sb-title">إيرادات البار</div>
        <div class="sb-val">@Model.TodayTotalProductCash.ToString("N2") <span class="fs-6 fw-bold">ج.م</span></div>
    </div>
    <div class="summary-box">
        <div class="sb-title">إيرادات جلسات الصالة</div>
        <div class="sb-val">@Model.TodayTotalTimeCash.ToString("N2") <span class="fs-6 fw-bold">ج.م</span></div>
    </div>
    <div class="summary-box">
        <div class="sb-title" style="color: var(--amber);">إيرادات الغرف المغلقة </div>
        <div class="sb-val val-amber">@Model.TodayTotalRoomCash.ToString("N2") <span class="fs-6 fw-bold">ج.م</span></div>
    </div>
    <div class="summary-box">
        <div class="sb-title">مبيعات الباقات</div>
        <div class="sb-val" style="background: linear-gradient(120deg, var(--violet-hint) 0%, var(--nav-orange-text) 100%); -webkit-background-clip: text; color: transparent;">
            @Model.TodayTotalPackageCash.ToString("N2") <span class="fs-6 fw-bold text-muted" style="-webkit-text-fill-color: var(--text-slate);">ج.م</span>
        </div>
    </div>
</div>

<h4 class="topbar-title mb-3 fs-5">2. الإيرادات حسب طريقة التحصيل</h4>
<div class="analysis-summary-grid mb-4" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
    <div class="summary-box" style="border-left: 4px solid #198754;">
        <div class="sb-title">المحصل (كاش نقدي)</div>
        <div class="sb-val" style="color: #198754;">
            @Model.TodayTotalCashMethod.ToString("N2") <span class="fs-6 fw-bold text-muted">ج.م</span>
        </div>
    </div>
    <div class="summary-box" style="border-left: 4px solid #6f42c1;">
        <div class="sb-title">المحصل (تحويل إنستاباي)</div>
        <div class="sb-val" style="color: #6f42c1;">
            @Model.TodayTotalInstaPayMethod.ToString("N2") <span class="fs-6 fw-bold text-muted">ج.م</span>
        </div>
    </div>
</div>

<h4 class="topbar-title mb-3 fs-5">3. ملخص الخزينة</h4>
<div class="analysis-summary-grid mb-5" style="grid-template-columns: 1fr;">
    <div class="summary-box" style="background: linear-gradient(135deg, var(--azure) 0%, #1E3A8A 100%); border: none;">
        <div class="sb-title text-white opacity-75">الإجمالي النهائي ليوم العمل</div>
        <div class="sb-val text-white" style="-webkit-text-fill-color: #ffffff; font-size: 2.5rem;">
            @Model.TodayTotalCash.ToString("N2") <span class="fs-5 fw-bold text-white opacity-75" style="-webkit-text-fill-color: rgba(255,255,255,0.75);">ج.م</span>
        </div>
    </div>
</div>

<hr style="border-color: var(--glass-edge-blue); margin-bottom: 2rem;" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="val-amber m-0 fs-4 fw-bold">
        جلسات الغرف المغلقة (@Model.ClosedRoomSessions.Count)
    </h3>
</div>

<div class="table-glass-wrap mb-5" style="border-color: rgba(255, 196, 0, 0.3);">
    <table class="table-glass">
        <thead style="background: linear-gradient(120deg, rgba(255, 250, 230, 0.9), rgba(255, 255, 255, 0.6));">
            <tr>
                <th>الغرفة</th>
                <th>العميل</th>
                <th>وقت البداية</th>
                <th>وقت النهاية</th>
                <th class="text-center">مدة الجلسة</th>
                <th style="width: 25%;">الطلبات</th>
                <th>إجمالي الإيراد</th>
                <th class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.ClosedRoomSessions.Any())
            {
                <tr>
                    <td colspan="8" class="text-center fw-bold py-4 text-muted">لا توجد جلسات غرف مغلقة اليوم.</td>
                </tr>
            }
            @foreach (var rs in Model.ClosedRoomSessions)
            {
                <tr>
                    <td class="fw-bold val-amber">@rs.RoomName</td>
                    <td class="fw-bold text-dark">@rs.CustomerName</td>
                    <td dir="ltr" class="text-end">@rs.StartTime.ToString("hh:mm tt")</td>
                    <td dir="ltr" class="text-end">@(rs.EndTime?.ToString("hh:mm tt"))</td>
                    <td class="text-center fw-bold text-muted">
                        @if (rs.EndTime.HasValue)
                        {
                            var duration = rs.EndTime.Value - rs.StartTime;
                            int h = (int)duration.TotalHours;
                            int m = duration.Minutes;
                            if (h > 0 && m > 0)
                            {
                                @($"{h} ساعة و {m} دقيقة")
                            }
                            else if (h > 0)
                            {
                                @($"{h} ساعة")
                            }
                            else
                            {
                                @($"{m} دقيقة")
                            }
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (rs.ProductNames != null && rs.ProductNames.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var product in rs.ProductNames)
                                {
                                    <span class="badge bg-warning text-dark opacity-75">@product</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fw-bold">-</span>
                        }
                    </td>
                    <td>
                        <span class="badge-glass val-amber fw-bold fs-6">
                            @rs.GrandTotal.ToString("N2") ج.م
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-1">
                            <a asp-controller="RoomSession" asp-action="Edit" asp-route-id="@rs.RoomSessionId" class="btn btn-sm" style="background: rgba(255, 196, 0, 0.15); color: #C9631A; border: 1px solid #FFC400; font-weight: 700; padding: 0.25rem 1rem;">تراجع</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center mb-3 mt-5">
    <h3 class="val-sapphire m-0 fs-4 fw-bold">
        جلسات الصالة المغلقة (@Model.ClosedSessions.Count)
    </h3>
</div>

<div class="table-glass-wrap">
    <table class="table-glass">
        <thead>
            <tr>
                <th>العميل</th>
                <th>رقم الهاتف</th>
                <th>وقت البداية</th>
                <th>وقت النهاية</th>
                <th class="text-center">مدة الجلسة</th>
                <th style="width: 25%;">المنتجات المطلوبة</th>
                <th>إجمالي الإيراد</th>
                <th class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.ClosedSessions.Any())
            {
                <tr>
                    <td colspan="8" class="text-center fw-bold py-4 text-muted">لا توجد جلسات صالة مغلقة اليوم.</td>
                </tr>
            }
            @foreach (var session in Model.ClosedSessions)
            {
                <tr>
                    <td class="fw-bold val-sapphire">@session.CustomerName</td>
                    <td class="fw-bold">@session.CustomerPhone</td>
                    <td dir="ltr" class="text-end">@session.StartTime.ToString("hh:mm tt")</td>
                    <td dir="ltr" class="text-end">@(session.EndTime?.ToString("hh:mm tt"))</td>
                    <td class="text-center fw-bold text-muted">
                        @if (session.EndTime.HasValue)
                        {
                            var duration = session.EndTime.Value - session.StartTime;
                            int h = (int)duration.TotalHours;
                            int m = duration.Minutes;
                            if (h > 0 && m > 0)
                            {
                                @($"{h} ساعة و {m} دقيقة")
                            }
                            else if (h > 0)
                            {
                                @($"{h} ساعة")
                            }
                            else
                            {
                                @($"{m} دقيقة")
                            }
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (session.ProductNames != null && session.ProductNames.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var product in session.ProductNames)
                                {
                                    <span style="background: var(--azure-glow-soft); padding: 4px 8px; border-radius: 6px; border: 1px solid var(--azure-glow); font-size: 0.85rem; color: var(--sapphire); font-weight: 700;">
                                        <bdi>@product</bdi>
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fw-bold">-</span>
                        }
                    </td>
                    <td>
                        <span class="badge-glass fs-6 text-white" style="background: var(--sapphire); border: none;">
                            @session.GrandTotal.ToString("N2") ج.م
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-1">
                            <a asp-controller="Session" asp-action="Edit" asp-route-id="@session.SessionId" class="btn btn-sm" style="background: rgba(255, 196, 0, 0.15); color: #C9631A; border: 1px solid #FFC400; font-weight: 700; padding: 0.25rem 1rem;">تراجع</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>