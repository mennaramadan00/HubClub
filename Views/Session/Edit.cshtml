@model HubClub.ViewModels.EditClosedSessionViewModel
@{
    ViewData["Title"] = "تعديل جلسة مغلقة";
}

<h3 style="color: var(--sapphire); font-weight: 800;">تعديل فاتورة الجلسة #@Model.SessionId</h3>
<hr />

<form asp-action="Edit" method="post" dir="rtl">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SessionId" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CusId" class="form-label fw-bold"></label>
            <select asp-for="CusId" asp-items="Model.AllCustomers" class="form-control"></select>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="PaymentType" class="form-label fw-bold"></label>
            <select asp-for="PaymentType" class="form-control" asp-items="Html.GetEnumSelectList<HubClub.Models.Enums.PaymentType>()"></select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="StartTime" class="form-label fw-bold"></label>
            <input type="text" class="form-control bg-light" value="@Model.StartTime.ToString("g")" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="EndTime" class="form-label fw-bold"></label>
            <input type="text" class="form-control bg-light" value="@Model.EndTime?.ToString("g")" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="HoursElapsed" class="form-label fw-bold"></label>
            <input asp-for="HoursElapsed" class="form-control bg-light" readonly />
        </div>
    </div>

    <!-- 🟢 جدول تعديل المنتجات -->
    <h5 class="fw-bold mt-4 mb-3" style="color: var(--sapphire);">المنتجات المطلوبة</h5>
    <div class="table-responsive mb-4">
        <table class="table table-bordered table-hover bg-white text-center align-middle">
            <thead class="bg-light">
                <tr>
                    <th>المنتج</th>
                    <th style="width: 150px;">سعر الوحدة</th>
                    <th style="width: 150px;">الكمية</th>
                    <th>إجمالي السطر</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Products.Count; i++)
                {
                    <tr>
                        <td class="fw-bold text-primary">
                            @Model.Products[i].ProductName
                            <input type="hidden" asp-for="Products[i].SessionProductId" />
                            <input type="hidden" asp-for="Products[i].ProductId" />
                            <input type="hidden" asp-for="Products[i].ProductName" />
                        </td>
                        <td>
                            <input asp-for="Products[i].UnitPriceAtSale" type="number" step="0.01" class="form-control text-center price-input" oninput="recalcLines()" />
                        </td>
                        <td>
                            <input asp-for="Products[i].Quantity" type="number" min="0" class="form-control text-center qty-input" oninput="recalcLines()" />
                        </td>
                        <td>
                            <span class="line-total fw-bold" id="line-total-@i">
                                @((Model.Products[i].UnitPriceAtSale * Model.Products[i].Quantity).ToString("N2"))
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row mt-3 p-3 rounded" style="background: rgba(0, 128, 255, 0.05); border: 1px dashed var(--azure-soft);">
        <div class="col-md-4 mb-3">
            <label asp-for="TotalTimePrice" class="form-label fw-bold text-primary"></label>
            <input asp-for="TotalTimePrice" type="number" step="0.01" class="form-control font-weight-bold" id="timePrice" oninput="recalcLines()" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="TotalProductPrice" class="form-label fw-bold text-primary"></label>
            <!-- 🟢 تم إغلاقه (readonly) لأنه يُحسب تلقائياً من الجدول -->
            <input asp-for="TotalProductPrice" type="number" step="0.01" class="form-control font-weight-bold bg-light" id="prodPrice" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="GrandTotal" class="form-label fw-bold text-danger"></label>
            <input asp-for="GrandTotal" type="number" step="0.01" class="form-control font-weight-bold bg-light" id="grandTotal" readonly />
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-4 px-5">حفظ التعديلات</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-4 px-4 mx-2">إلغاء</a>
</form>

<script>
    function recalcLines() {
        let totalProducts = 0;
        const prices = document.querySelectorAll('.price-input');
        const qtys = document.querySelectorAll('.qty-input');
        const totals = document.querySelectorAll('.line-total');

        for (let i = 0; i < prices.length; i++) {
            let p = parseFloat(prices[i].value) || 0;
            let q = parseInt(qtys[i].value) || 0;
            let lineTot = p * q;

            totals[i].textContent = lineTot.toFixed(2);
            totalProducts += lineTot;
        }

        document.getElementById('prodPrice').value = totalProducts.toFixed(2);

        let t = parseFloat(document.getElementById('timePrice').value) || 0;
        document.getElementById('grandTotal').value = (t + totalProducts).toFixed(2);
    }
</script>