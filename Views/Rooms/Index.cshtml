@model IEnumerable<HubClub.Models.Room>
@{
    ViewData["Title"] = "إدارة الغرف";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="topbar-title">إدارة الغرف المتاحة</h2>
    <a asp-action="Create" class="btn-aurelian-primary">إضافة غرفة جديدة +</a>
</div>

<div class="table-glass-wrap">
    <table class="table-glass">
        <thead>
            <tr>
                <th>اسم الغرفة</th>
                <th>حالة الغرفة</th>
                <th class="text-center-glass">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Name</strong></td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge-glass">متاحة للاستخدام</span>
                        }
                        else
                        {

                            <span class="badge-glass badge-danger-glass">موقوفة</span>
                        }
                    </td>
                    <td class="table-actions-cell">
                        <a asp-action="Details" asp-route-id="@item.RoomId" class="btn-aurelian-outline">التفاصيل والسجل</a>
                        <a asp-action="Edit" asp-route-id="@item.RoomId" class="btn-aurelian-outline">تعديل</a>
                        <a asp-action="Delete" asp-route-id="@item.RoomId" class="btn-aurelian-outline btn-outline-danger">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>