@model HubClub.ViewModels.RoomSessionOpenViewModel
@{ ViewData["Title"] = "فتح جلسة غرفة"; }

<div class="glass-form-container">
    <div class="form-header">
        <h2>فتح جلسة غرفة جديدة</h2>
        <p>قم باختيار الغرفة، التسعيرة، وتحديد العميل (اختياري)</p>
    </div>

    <form asp-action="Open">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 form-group mb-4">
                <label asp-for="RoomId" class="premium-label"></label>
                <select asp-for="RoomId" class="premium-input" asp-items="Model.AvailableRooms">
                    <option value="">-- اختر الغرفة --</option>
                </select>
                <span asp-validation-for="RoomId" class="text-danger"></span>
            </div>

            <div class="col-md-6 form-group mb-4">
                <label asp-for="SelectedHourlyPrice" class="premium-label"></label>
                <select asp-for="SelectedHourlyPrice" class="premium-input" asp-items="Model.AvailablePrices">
                    <option value="">-- اختر تسعيرة الساعة --</option>
                </select>
                <span asp-validation-for="SelectedHourlyPrice" class="text-danger"></span>
            </div>
        </div>

        <hr class="mb-4 text-muted" />

        <div class="form-group form-check mb-4">
            <label class="form-check-label premium-label cursor-pointer">
                <input class="form-check-input ms-2" asp-for="IsNewCustomer" id="chkNewCustomer" /> 
                تسجيل عميل جديد
            </label>
        </div>

        <!-- قسم العميل المسجل مسبقاً -->
        <div class="form-group mb-4" id="divExistingCustomer">
            <label asp-for="SelectedCustomerId" class="premium-label"></label>
            <select asp-for="SelectedCustomerId" class="premium-input" asp-items="Model.AllCustomers">
                <option value="">--  تسجيل عميل موجود --</option>
            </select>
            <span asp-validation-for="SelectedCustomerId" class="text-danger"></span>
        </div>

        <!-- قسم العميل الجديد -->
        <div id="divNewCustomer" class="d-none">
            <div class="form-group mb-4">
                <label asp-for="NewCustomerName" class="premium-label"></label>
                <input asp-for="NewCustomerName" class="premium-input" placeholder="اسم العميل الجديد" autocomplete="off" />
                <span asp-validation-for="NewCustomerName" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="NewCustomerPhone" class="premium-label"></label>
                <input asp-for="NewCustomerPhone" class="premium-input" placeholder="رقم الموبايل" autocomplete="off" />
                <span asp-validation-for="NewCustomerPhone" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions mt-5">
            <a asp-controller="Home" asp-action="Index" class="btn-aurelian-outline">إلغاء</a>
            <button type="submit" class="btn-aurelian-primary">بدء الجلسة</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            function toggleCustomerFields() {
                if ($('#chkNewCustomer').is(':checked')) {
                    $('#divExistingCustomer').addClass('d-none');
                    $('#divNewCustomer').removeClass('d-none');
                    $('#SelectedCustomerId').val('');
                } else {
                    $('#divNewCustomer').addClass('d-none');
                    $('#divExistingCustomer').removeClass('d-none');
                    $('#NewCustomerName, #NewCustomerPhone').val('');
                }
            }
            $('#chkNewCustomer').change(toggleCustomerFields);
            toggleCustomerFields();
        });
    </script>
}