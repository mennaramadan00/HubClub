@model HubClub.Models.RoomPricing
@{
    ViewData["Title"] = "إضافة تسعيرة";
}

<div class="glass-form-container">
    <div class="form-header">
        <h2>إضافة تسعيرة غرفة جديدة</h2>
        <p>قم بإضافة السعر ليظهر للكاشير في شاشة فتح جلسات الغرف</p>
    </div>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group mb-5">
            <label asp-for="PricePerHour" class="premium-label"></label>
            <input asp-for="PricePerHour" class="premium-input" placeholder="مثال: 50.00" autocomplete="off" type="number" step="0.01" />
            <span asp-validation-for="PricePerHour" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-aurelian-outline">عودة للقائمة</a>
            <button type="submit" class="btn-aurelian-primary">حفظ التسعيرة</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}