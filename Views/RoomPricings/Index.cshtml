@model IEnumerable<HubClub.Models.RoomPricing>
@{
    ViewData["Title"] = "أسعار الغرف";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="topbar-title">إدارة أسعار الغرف</h2>
    <a asp-action="Create" class="btn-aurelian-primary">إضافة تسعيرة جديدة +</a>
</div>

<div class="table-glass-wrap">
    <table class="table-glass">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.PricePerHour)</th>
                <th class="text-center-glass">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><strong class="price-highlight">@item.PricePerHour.ToString("N2") ج.م</strong></td>
                        <td class="text-center-glass">
                            <a asp-action="Delete" asp-route-id="@item.RoomPricingId" class="btn-aurelian-outline btn-outline-danger">حذف التسعيرة</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="empty-table-msg">لا توجد أي أسعار مسجلة حتى الآن.</td>
                </tr>
            }
        </tbody>
    </table>
</div>